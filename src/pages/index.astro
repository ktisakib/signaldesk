---
import '../styles/global.css';
import '../styles/studio.css';
import '../styles/admin.css';
import HomeEntry from '../components/HomeEntry';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SignalDesk — Television broadcast operations, IPTV playout relay, and licensing administration." />
    <title>SignalDesk · Operations & Administration</title>
    <script is:inline>
      if (typeof window !== "undefined" && ("__TAURI_INTERNALS__" in window || "__TAURI__" in window || window.origin?.includes("tauri"))) {
        window.isTauri = true;
      }
    </script>
  </head>
  <body class="bg-[#0d1210] text-[#e8ede9] min-h-screen">
    <HomeEntry client:only="react" />
    <noscript>SignalDesk requires JavaScript to load the operations dashboard.</noscript>
  </body>
</html>
