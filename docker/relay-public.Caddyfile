{
    on_demand_tls {
        ask http://relay:9791/tls/allow
    }
}
:8088 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    reverse_proxy relay:9790
}
:80 {
    redir https://{host}{uri} permanent
}
https:// {
    tls {
        on_demand
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    reverse_proxy relay:9790
}
